;
; i2s.pio — I2S 输出（主模式，32bit/声道，48kHz）
;
; ==================================================================
; 设计说明（改代码前务必读完）
; ==================================================================
;
; 【引脚映射】side-set 与 out 必须落在相邻 GPIO：
;   side-set bit 0 → LRCK
;   side-set bit 1 → BCK
;   out  bit 0     → DIN  (= side_set_base + 2)
;
;   当前 board_config.h：LRCK=GPIO12, BCK=GPIO13, DIN=GPIO14 ✓ 连续
;   i2s.c 有编译期断言检查这一点。
;
; ==================================================================
; ★★★ 为什么用 `set x, 31` 计数，而不是 `jmp !osre`（这里改过一版）
; ==================================================================
;
;   上一版靠 "OSR 移空 32 位后 `jmp !osre` 落空" 来切左右声道，
;   并声称"每声道正好 320 周期、误差 0"。**这个机制是错的。**
;
;   原因：i2s.c 里开了 **autopull**，OSR 一空就会被自动从 TX FIFO 补充。
;         而 `jmp !osre` 判断的是 `osre` 这个**状态标志**，
;         补数一发生 `osre` 就被清掉 —— 于是 jmp 每次都跳，
;         状态机永远出不了 left_loop，LRCK 一直贴在低电平，
;         右声道的数据根本发不出去。
;
;   证据（tools/../pio_sim.py，一个按指令集建模的 PIO 模拟器，
;   跑的是 build/i2s.pio.h 里 pioasm 真正汇编出来的机器码）：
;         关掉 autopull：LRCK 占空 50.0%，左右声道各 320 周期  ← 正常
;         打开 autopull：LRCK 占空 92.0%，700 周期里只翻转 31 次 ← 坏的
;   现场实测也吻合：板子上量到 BCK 有波形（30% 占空 = 1.0V），
;   而 **LRCK 恒为 0V** —— 正是"卡在左声道"的症状。
;
;   → 改用 **显式计数器** `set x, 31` + `jmp x--`。
;     这个机制不依赖任何状态标志，行为是确定的。
;
;   ★ 代价：每声道多 1 条 `set x` 指令 → 每帧 642 周期而不是 640。
;     但**没有引入任何音高误差** —— 分频器按 642 周期/帧来算
;     （见 board_config.h 的 BOARD_I2S_PIO_CYCLES_PER_FRAME）：
;         期望 SM 频率 = 48000 × 642 = 30.816 MHz
;         分频 = 150e6 / 30.816e6 = 4.8671875
;         → LRCK = 30.8186e6 / 642 = 48004 Hz   （+0.008%）
;         → BCK  = 64/642 × 30.8186e6 = 3.0723 MHz（+0.008%）
;     换句话说：多出来的 2 个周期落在 `set x` 上（此时 BCK 保持低），
;     只是把 BCK 的低电平拉长了一点点，PCM5102A 完全不在乎占空比，
;     它只要求"每个 LRCK 周期里正好 64 个 BCK 脉冲" —— 这一点满足。
;
;   ★ 注意 `jmp x--` 在 x==0 时**不跳转**并把 x 减成 0xFFFFFFFF，
;     所以紧接着必须有一条 `set x, 31` 重新装载 —— 这正是每声道
;     开头那 1 个额外周期的来源，也是设计的一部分。
;
; ------------------------------------------------------------------
; 【每 bit 10 个 SM 周期的对账】
; ------------------------------------------------------------------
;   前半（数据 + BCK 拉低）：
;     周期 1 : out pins, 1       side 0b00    DIN ← OSR 最高位
;     周期 2~5: nop              side 0b00
;   后半（BCK 脉冲）：
;     周期 6 : nop              side 0b10    BCK ↑ ← 采样沿
;     周期 7 : nop              side 0b10
;     周期 8 : nop              side 0b10
;     周期 9 : nop              side 0b00    BCK ↓
;     周期10 : jmp x-- loop     side 0b00
;
;   BCK 高电平 3 个周期 / 低电平 7 个周期 = 30% 占空比。
;   PCM5102A 对 BCLK 占空比没有要求，只要**每帧 64 个脉冲**且频率正确。
;   数据在周期 1 变化，BCK 在周期 6 上升 → **5 个 SM 周期（163 ns）建立时间**，
;   远超 PCM5102A 的需求（数据手册要求 ns 级）。
;
; ------------------------------------------------------------------
; 【为什么每 bit 必须是 10 个 SM 周期】
; ------------------------------------------------------------------
;   48 kHz、64 bit/帧、150 MHz 下，每 bit 的"总分频" = 150e6/(48000×64)
;   = 48.828125，不是整数。PIO 的分数分频器按 SM 周期平均出这个比值，
;   所以"每 bit 几个 SM 周期"（由程序决定的整数 C）必须能和 48.828125
;   对上相位。48.828125 = 3125/64，3125 = 5^5，所以 C 必须是 5 的倍数：
;       C=5  : 3125/5  = 625      整数，相位对齐
;       C=10 : 3125/10 = 312.5    每 2 bit 一个整数周期，也对齐
;       C=4  : 781.25             不对齐，有抖动
;   C=10 是唯一能装下"数据 + BCK 上升/保持/下降"这 4 个动作的 5 的倍数。
;
;   ★ 本版每帧是 642 而不是 640，分频按 642 算（见上），
;     所以"48.828125"这个数现在是 150e6/(48000×642/64) —— 一样是
;     按 642 周期/帧反推出来的，相位依然对齐，没有抖动。
; ==================================================================

.program i2s_out
.side_set 2

; ★ side-set 编码（与 i2s.c 的 sm_config_set_sideset_pins(LRCK) 严格对应）
;
;   side_set_base = PIN_I2S_LRCK = GPIO12，所以：
;       side bit0 → GPIO12 = LRCK
;       side bit1 → GPIO13 = BCK
;       out 引脚从 GPIO14 = DIN 开始
;
;   四个取值：
;       0b00 → LRCK=0  BCK=0    左声道，BCK 低
;       0b10 → LRCK=0  BCK=1    左声道，BCK 高
;       0b01 → LRCK=1  BCK=0    右声道，BCK 低
;       0b11 → LRCK=1  BCK=1    右声道，BCK 高
;
;   ★ 这里踩过坑：如果按"0b01 = BCK 高"的直觉写，实际得到的是
;     "LRCK=1, BCK=0"（因为 0b01 的 bit0 是 LRCK）。
;     tools/verify_i2s_timing.py 会逐条检查 LRCK/BCK，写错会直接报错。

.wrap_target
    ; ---- 左声道：32 bit ----
    ; ★ `set x, 31` 是每声道固定开销（`jmp x--` 归零后要重新装载），
    ;   它就是 642 里多出来的那 2 个周期。side 保持 0b00。
    set x, 31               side 0b00
left_loop:
    out pins, 1             side 0b00   ; 周期 1：DIN ← OSR 最高位
    nop                     side 0b00   ; 周期 2
    nop                     side 0b00   ; 周期 3
    nop                     side 0b00   ; 周期 4
    nop                     side 0b00   ; 周期 5
    nop                     side 0b10   ; 周期 6：BCK ↑（采样沿）
    nop                     side 0b10   ; 周期 7
    nop                     side 0b10   ; 周期 8
    nop                     side 0b00   ; 周期 9：BCK ↓
    jmp x-- left_loop       side 0b00   ; 周期 10；x==0 时不跳，落到右声道

    ; ---- 右声道：32 bit ----
    set x, 31               side 0b01
right_loop:
    out pins, 1             side 0b01
    nop                     side 0b01
    nop                     side 0b01
    nop                     side 0b01
    nop                     side 0b01
    nop                     side 0b11   ; BCK ↑（LRCK 保持高）
    nop                     side 0b11
    nop                     side 0b11
    nop                     side 0b01   ; BCK ↓
    jmp x-- right_loop      side 0b01
.wrap
