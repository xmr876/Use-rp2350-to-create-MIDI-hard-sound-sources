;
; uart_rx.pio — 31250 波特 8N1 的 UART 接收器（纯 PIO，任意 GPIO 都能用）
;
; ==================================================================
; 【为什么不用硬件 UART —— 这是本工程踩过最大的一个坑】
; ==================================================================
;
;   RP2350 的 GPIO 功能是**固定映射**的，没有"交换矩阵"。
;   UART1 的引脚分组（以官方引脚表为准）：
;       TX : 4, 8, 20, 24       RX : 5, 9, 21, 25
;       CTS（AUX 模式下当 TX）: 6, 10, 22, 26
;       RTS（AUX 模式下当 RX）: 7, 11, 23, 27
;
;   → **GP10 只能做 UART1 的 TX 或 CTS，永远做不了 RX。**
;     载板把光耦输出接在 GP10 上，所以硬件 UART 这条路根本走不通。
;
;   更糟的是：把 GP10 配成 UART1 的 TX（功能 11）之后，**TX 空闲时主动
;   输出高电平**，直接把光耦的输出顶住了。现场现象：
;       光耦 pin6 稳定 3.3V（本该在翻转）
;       光耦 pin6 对 3V3 量到 0Ω（那是 RP2350 的输出驱动器）
;       一个 MIDI 字节都收不到
;   这三条一度被误判成"焊接问题""线接反""量法不对"。
;
;   → 改用 PIO 收：PIO 读引脚是**纯输入**，不驱动，
;     而且任意 GPIO 都能用，载板一根线都不用改。
;
; ==================================================================
; 【时序设计】
; ==================================================================
;   MIDI 波特率 31250，8N1（1 起始位 + 8 数据位 + 1 停止位，LSB 先发）。
;
;   取 **每 bit 8 个 SM 周期**：
;       SM 频率 = 31250 × 8 = 250 kHz
;       分频    = 150 MHz / 250 kHz = **600**（整数，零抖动）
;
;   采样时刻（周期数，从"检测到起始位下降沿"那个周期算起）：
;       位 0 中心 = 1.5 bit = 12 周期
;       位 n 中心 = 12 + 8n
;       位 7 中心 = 68
;       停止位中心 = 76，停止位结束 = 80
;
;   ★ 用"位中心采样"而不是边沿采样：起始位检测有最多 1 个周期的量化
;     误差，加上输入同步的 2 个周期，位中心采样能容忍 ±3 个周期
;     （±37% 位宽）的偏差，非常宽裕。
;
; ==================================================================
; 【失步自恢复】
; ==================================================================
;   程序末尾先 `wait 1 pin` 等线路回到**空闲高电平**，再等下降沿找起始位。
;   这样即使因为某种原因（比如 RX FIFO 满导致 push 阻塞）错过了一个字节，
;   也会在总线空闲时自动重新同步，而不是一路错下去。
;
; ==================================================================
; 【引脚号为什么写成字面量 10】
; ==================================================================
;   PIO 的 `wait ... pin N` 用的是**绝对 GPIO 编号**（0~31），
;   不是相对于 in-base 的偏移，所以没法从 C 侧传进来，
;   只能在 .pio 里写死。
;   tools/verify_midi.py 会核对这里的 MIDI_RX_PIN 与 board_config.h 的
;   PIN_MIDI_RX 是否一致，不一致直接报错。
; ==================================================================

.define MIDI_RX_PIN 10

.program uart_rx

.wrap_target
    ; --- 等起始位 ---
    wait 0 pin MIDI_RX_PIN      ; 线路变低 = 起始位开始

    ; --- 延时到位 0 的中心（12 周期，已用 0）---
    set x, 7            [5]     ; 1 + 5 = 6 周期
    nop                 [4]     ; 1 + 4 = 5 周期   （累计 11）
    nop                         ; 1 周期           （累计 12 ✓）

bitloop:
    in pins, 1                  ; 采样一位（LSB 先到，配 shift_left 正好）
    jmp x-- bitloop     [6]     ; 1 + 1 + 6 = 每 bit 8 周期

    ; --- 8 位采完，此时位于停止位中部（周期 76）---
    push block                  ; 推入 RX FIFO；满了就在这里等（反压）
    nop                 [3]     ; 等停止位走完（周期 80）

    ; --- 等线路空闲，失步也能自动重同步 ---
    wait 1 pin MIDI_RX_PIN
.wrap
